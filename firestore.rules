rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /rooms/{room} {
   allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
   allow read: if request.auth != null;
   allow update, delete: if request.auth != null && resource.data.owner == request.auth.uid;
   match /teams/{team} {
    allow read: if request.auth != null;
    allow create: if request.auth != null && team == request.auth.uid && request.resource.data.score == 0;
    allow update: if request.auth != null && get(/databases/$(database)/documents/rooms/$(room)).data.owner == request.auth.uid;
   }
   match /submissions/{submission} {
    allow read: if request.auth != null;
    allow create: if request.auth != null && request.resource.data.teamId == request.auth.uid && submission.matches(request.auth.uid + '_[0-2]') && get(/databases/$(database)/documents/rooms/$(room)).data.phase == 'open' && request.resource.data.stage == get(/databases/$(database)/documents/rooms/$(room)).data.stage;
    allow update, delete: if false;
   }
  }
 }
}
